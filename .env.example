ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo usado para interpretar descripciones (por defecto claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# Opcional: maximo de niveles por minuto por IP (por defecto 20)
# GENERATE_LIMIT_PER_MINUTE=20
# Opcional: maximo de llamadas diarias a Claude antes de usar el respaldo (por defecto 1000)
# AI_DAILY_LIMIT=1000
# Opcional: base de datos en la nube (Turso). Sin esto se usa data/app.db local.
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=...
# Opcional (solo desarrollo): carpeta del repo del frontend para servirlo en local
# FRONTEND_DIR=../AI_level-frontend
# Juegos escritos a medida por la IA cuando ningun estilo encaja (cuestan ~10-20 centavos cada uno).
# CUSTOM_GAMES=off desactiva la funcion; CUSTOM_DAILY_LIMIT fija el tope diario (por defecto 20).
# CUSTOM_GAMES=on
# CUSTOM_DAILY_LIMIT=20
